# The MONEVA API as a Lambda container image.
#
# A container rather than a zip, and not by preference: the installed
# dependencies come to roughly 200 MB once the development ones are excluded,
# against Lambda's 250 MB unzipped limit for a zip. google-generativeai alone
# pulls in googleapiclient and grpc, which are over 130 MB between them.
# Fighting that with layers would mean splitting the dependency tree across
# artefacts that then have to be kept in step. A container image allows 10 GB
# and needs none of that.
#
# Measured before choosing: googleapiclient 100.2 MB, google 21.4 MB,
# sqlalchemy 18.1 MB, grpc 12.7 MB, cryptography 10.6 MB.

FROM public.ecr.aws/lambda/python:3.12

# Dependencies first and on their own layer, so editing application code does
# not re-download 200 MB of wheels on every build.
COPY requirements.txt ${LAMBDA_TASK_ROOT}/

# Mangum is only needed here - it is the ASGI-to-Lambda adapter, and installing
# it into the normal requirements would put it in the uvicorn deployment and
# every developer's virtualenv for no reason.
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt \
    && pip install --no-cache-dir "mangum>=0.17.0"

COPY main.py lambda_handler.py ${LAMBDA_TASK_ROOT}/
COPY app/ ${LAMBDA_TASK_ROOT}/app/

# Migrations are deliberately NOT copied. Running alembic from inside the
# request path is the classic way to have several concurrent Lambdas try to
# migrate the same database at once. Run them from a machine that can reach the
# database, before the new image goes live.

CMD ["lambda_handler.handler"]
