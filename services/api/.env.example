# MONEVA API environment
# Copy to .env (or set these in your shell) - never commit real values.

# ---------------------------------------------------------------------------
# ASSISTANT (Gemini)
# ---------------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# WITHOUT this key the assistant still works, but falls back to the
# deterministic keyword engine, which needs a spend verb
# ("spent 711.83 on fuel" works; "bike refueled at 711.83" does not).
# WITH it, the model understands natural phrasing. It stays read-only and
# every mutation is still proposed, confirmed by the user, then executed by
# the normal endpoint.
GEMINI_API_KEY=

# Optional - defaults to gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Must be at least 32 characters in a non-test environment.
# JWT_SECRET=
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=60

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./monevadb.db
