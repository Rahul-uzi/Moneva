# Copy to keystore.properties (same folder) and fill in.
#
# keystore.properties is git-ignored and must stay that way: it holds the
# password to the key that identifies MONEVA to Android. Anyone with the
# keystore file and this password can publish an update that every existing
# install will accept as genuine.
#
# Create the key once:
#
#   keytool -genkeypair -v -keystore moneva-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias moneva
#
# Then back up moneva-release.jks somewhere that is not this machine. It cannot
# be regenerated or replaced: Android identifies an app by its signing
# certificate, so an APK signed with a different key will not install over an
# existing MONEVA. Losing this file means everyone who installed the app has to
# uninstall it - and lose what it kept on the device - before they can ever
# update again.

storeFile=moneva-release.jks
storePassword=
keyAlias=moneva
keyPassword=
