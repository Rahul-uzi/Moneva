<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config.

  This file lives in the `debug` source set, so it is compiled into debug
  builds ONLY and can never ship in a release APK. It permits cleartext HTTP
  to any host so that a development LAN address change (a new DHCP lease)
  no longer requires editing an allow-list and rebuilding.

  The release build uses src/main/res/xml/network_security_config.xml, which
  keeps cleartextTrafficPermitted="false".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
