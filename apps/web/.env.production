# Production build config for the MONEVA Android app.
#
# Vite inlines this at BUILD time, so whatever is here is baked into the APK.
# Replace the placeholder with your Render URL, then build:
#
#   npm run build:web
#   cd apps/web && npx cap sync android
#   cd android && gradlew.bat assembleRelease
#
# MUST be https. The release network security config refuses cleartext, so an
# http:// endpoint here produces an app that cannot reach its own API.
VITE_API_BASE_URL=https://moneva.onrender.com/api

VITE_APP_NAME=MONEVA
VITE_APP_VERSION=1.0.0
