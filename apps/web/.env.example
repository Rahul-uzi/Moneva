# MONEVA Web Client Environment Variables
# Copy this file to .env and configure the values.

# ---------------------------------------------------------------------------
# API ENDPOINT
# ---------------------------------------------------------------------------
# Vite inlines this at BUILD time, so it is baked into the APK.
# After changing it you must rebuild and reinstall:
#   npm run build:web && npx cap sync android
#   cd apps/web/android && gradlew.bat assembleDebug
#
# LOCAL DEV (current setup) - phone and dev machine on the same Wi-Fi.
# The host part MUST match the machine's current LAN IP. A DHCP lease change
# breaks the app, and the same IP must also be listed as a cleartext domain in
#   apps/web/android/app/src/main/res/xml/network_security_config.xml
# Consider a DHCP reservation so the address stops moving.
VITE_API_BASE_URL=http://192.168.1.6:8000/api

# MOBILE DATA / OFF-NETWORK (not enabled)
# A LAN address is unreachable over mobile data. To use the app away from the
# home network, publish the API on a real HTTPS host and point this at it:
#   VITE_API_BASE_URL=https://api.your-domain.example/api
# Then delete the cleartext domain-config from network_security_config.xml.

# App details
VITE_APP_NAME=MONEVA
VITE_APP_VERSION=1.0.0
